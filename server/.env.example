# WhisperShare Server Environment Variables Template

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas URI or local MongoDB instance)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/whispershare?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/whispershare
MONGODB_URI=mongodb://127.0.0.1:27017/whispershare

# 256-bit AES-256-GCM Master Encryption Key (64-character hex string)
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here
